+            >
+              <span className="truncate font-mono text-xs text-ink">{unit.serialNumber}</span>
+              <span className="font-mono text-xs text-ink-soft">{unit.grade}</span>
+              <span className="truncate text-ink-soft">{unit.color}</span>
